{
  "name": "微信工作群",
  "description": "适合微信工作群消息的特征",
  "triggers": [
    {"keyword": "@我", "field": "assigned_to_me", "value": true, "boost_priority": 2},
    {"keyword": "紧急", "field": "priority", "value": "P0"},
    {"keyword": "今天", "field": "deadline", "boost_priority": 1},
    {"keyword": "尽快", "field": "priority", "value": "P1"},
    {"keyword": "截止", "field": "deadline", "boost_priority": 1},
    {"pattern": "@\\w+", "field": "is_task", "value": true}
  ],
  "auto_complete": [
    {
      "if": {"text_contains": "查一下"},
      "then": {"action": "fetch_data", "handler": "tencent_api"}
    }
  ]
}